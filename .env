# Local OpenCloud for the quality project (Docker Desktop, side by side with Kubernetes).
# Full list of options: .env.example

# Fixed project name -> containers/network are named "opencloud-*"
COMPOSE_PROJECT_NAME=opencloud

# Which compose files make up the stack: OpenCloud + Traefik reverse proxy
# + local-src/opencloud.yml = build OpenCloud from ../opencloud and ../web instead of Docker Hub
#   (remove that entry to go back to the published image)
# single-container (monolith) deployment:
# COMPOSE_FILE=docker-compose.yml;traefik/opencloud.yml;local-src/opencloud.yml
# split into 6 components (see split/README.md):
COMPOSE_FILE=docker-compose.yml;traefik/opencloud.yml;local-src/opencloud.yml;split/split.yml;split/local-src.yml;swagger/swagger-ui.yml;traefik/swagger-ui.yml
# ';' separator because we are on Windows
COMPOSE_PATH_SEPARATOR=;

# Docker Desktop's Kubernetes ingress-nginx already owns ports 80/443,
# so OpenCloud's Traefik listens on 4080/4443 instead (avoid 8000-9999 and 5232).
TRAEFIK_PORT_HTTP=4080
TRAEFIK_PORT_HTTPS=4443

# Local machine: no Let's Encrypt. Traefik serves its own self-signed certificate.
TRAEFIK_SERVICES_TLS_CONFIG="tls=true"
INSECURE=true

# URL will be https://cloud.opencloud.localtest.me:4443
# *.localtest.me is public DNS that always resolves to 127.0.0.1 -> no hosts-file edit needed
OC_DOMAIN=cloud.opencloud.localtest.me

# Admin login: user "admin" + this password. Only read on the FIRST start.
INITIAL_ADMIN_PASSWORD=admin

# Demo users alan, mary, margaret, dennis, lynn (password: demo) - handy for testing
DEMO_USERS=true

LOG_LEVEL=info
LOG_PRETTY=true
